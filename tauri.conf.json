{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sylva Chat",
  "mainBinaryName": "Sylva Chat",
  "version": "0.1.0",
  "identifier": "app.sylva.chat",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sylva Chat",
        "width": 420,
        "height": 760,
        "minWidth": 300,
        "minHeight": 360,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost wss://irc-ws.chat.twitch.tv"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Sylva",
    "category": "SocialNetworking",
    "shortDescription": "Fast Twitch chat for streamers.",
    "longDescription": "Sylva Chat is Twitch chat with 7TV, BTTV and FFZ emotes, chat history, and one-click delete, timeout and ban, in Sylva's look.",
    "copyright": "Copyright 2026 haruxee",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMjM3OURFNEE0MUM0MEMKUldRTXhFRkszbmtqZ09MZUdHS3V6VlRHd1Ivamhod0FpVUFUdVdya2FjNlFrUjRncFhtbWpLODUK",
      "endpoints": [
        "https://github.com/SylvaBot/sylva-chat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
